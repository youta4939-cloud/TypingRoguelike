 "fields": {
  "breath": {
   "BREATH_DY": 5.0,
   "BREATH_DX": 0.009,
   "formula": "dy=-BREATH_DY*breath*smoothstep((720-y)/300); dx=BREATH_DX*breath*(x-560)*exp(-((y-520)/120)^2)  (rest canvas px)",
   "implemented_by": [
    "BreathY",
    "BreathX bones on torso/ribbon; Head/Halberd/torso-rooted chain roots get breath_disp(their head) as a localPosition offset"
   ]
  },
  "chest_softness": {
   "center_px": [
    540.0,
    560.0
   ],
   "sigma_x": 130.0,
   "sigma_up": 90.0,
   "sigma_down": 45.0,
   "layers": [
    "torso",
    "ribbon"
   ],
   "formula": "disp = (chest_x, chest_y) * exp(-((x-540)/130)^2 - ((y-560)/sy)^2), sy=90 above / 45 below the centre",
   "implemented_by": "ChestSoft bone"
  },
  "groove": {
   "HIP_Y": 820.0,
   "FOOT_Y": 1560.0,
   "formula": "disp=(hipx,bob)*smoothstep((FOOT_Y-y)/(FOOT_Y-HIP_Y)) applied after everything",
   "implemented_by": "Groove bone; leg_L/leg_R/garter_L/garter_R vertices blend Groove/Anchor by that weight. Other parts ride Groove fully (tail tip differs up to ~8px at the bottom of a beat from the reference renderer, reads natural)"
  }
 },
 "face_variants": {
  "part": "head",
  "Default": "Sprites/head.png",
  "Hurt": "Sprites/head_hurt.png",
  "note": "identical rect/pivot/alpha; swap SpriteRenderer.sprite. Hurt = トダ hurt expression (eyes/brows/mouth), purple iris"
 },
 "panel": {
  "screen": "E5b battle screen 1920x1080, left ally panel x 0..640",
  "mask": "Reference/panel_mask_640x1080.png (diagonal cut (620,0)-(470,1080), white = visible)",
  "camera": "screen_px = (canvas_px - (615,300)) * cam.scale + (440,300) + (cam.dx + shake.x, cam.dy + shake.y)   (screen y down, 1080 high)",
  "fullbody_camera": "screen_px = canvas_px + (0.6*cam.dx + shake.x, 0.6*cam.dy + shake.y)"
 },
 "notes": [
  "torso sprite = the renderer crop (x<772); 227 px of stray wing fragments beyond it are intentionally not shipped (they never appear in the approved videos)",
